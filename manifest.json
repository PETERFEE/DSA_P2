{
  "manifest_version": 3,
  "name": "Gmail Spam Scanner",
  "version": "1.0",
  "description": "Scans the currently open email in Gmail for common spam keywords.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://mail.google.com/"
  
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon.png"
    }
  }
}
